PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_NS=wcs
OPEN_LIBRARY_BASE=https://openlibrary.org
JWT_SECRET=wcs-dev-secret-change-in-production
JWT_EXPIRES_IN=7d

# Optional: WCS commerce backend (wcs-ios simulation) for live Apple API status.
# Local: PORT=8787 npm start  (in wcs-ios/backend) — port 8080 is often used by Apache.
# WCS_COMMERCE_BASE_URL=http://127.0.0.1:8787
# Vercel: set WCS_COMMERCE_BASE_URL to your deployed commerce API URL, or omit for built-in simulation.
